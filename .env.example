# Copy to .env for local development. Never commit .env.

# Neon connection string. Use a separate Neon branch for local development.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=verify-full

# Signs staff login cookies. Required in production; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Optional locally: without it, quote request emails are logged instead of sent.
RESEND_API_KEY=
FROM_EMAIL=noreply@soundsgoodav.com
TO_EMAIL=info@soundsgoodav.com
